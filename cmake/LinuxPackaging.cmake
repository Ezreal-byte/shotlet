include(GNUInstallDirs)
install(TARGETS shotlet RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
install(FILES packaging/linux/shotlet.desktop DESTINATION ${CMAKE_INSTALL_DATADIR}/applications)
install(FILES packaging/linux/shotlet.svg DESTINATION ${CMAKE_INSTALL_DATADIR}/icons/hicolor/scalable/apps)
install(FILES LICENSE THIRD_PARTY_NOTICES.md DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/shotlet)
install(FILES "${SDL3_DIR}/LICENSE.txt" DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/shotlet RENAME SDL-LICENSE.txt)
install(FILES "${IMGUI_DIR}/LICENSE.txt" DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/shotlet RENAME ImGui-LICENSE.txt)
install(FILES src/third_party/nlohmann/LICENSE.MIT DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/shotlet RENAME nlohmann-json-LICENSE.txt)
set(CPACK_PACKAGE_NAME shotlet)
set(CPACK_PACKAGE_VENDOR "Shotlet contributors")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Native X11 screenshot and annotation tool")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/imjakey/shotlet")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "Shotlet contributors")
set(CPACK_DEBIAN_PACKAGE_SECTION graphics)
set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
    set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE arm64)
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
    set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE amd64)
else()
    message(FATAL_ERROR "Linux packages currently support only x86_64 and ARM64")
endif()
set(CPACK_DEBIAN_PACKAGE_DEPENDS "zenity, fonts-noto-cjk | fonts-wqy-zenhei")
set(CPACK_DEBIAN_PACKAGE_RECOMMENDS "libvulkan1")
if(SHOTLET_ZIG)
    get_filename_component(shotlet_zig_real_path "${SHOTLET_ZIG}" REALPATH)
    get_filename_component(shotlet_zig_directory "${shotlet_zig_real_path}" DIRECTORY)
    foreach(runtime libcxx libcxxabi libunwind)
        install(FILES "${shotlet_zig_directory}/lib/${runtime}/LICENSE.TXT"
            DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/shotlet RENAME "LLVM-${runtime}-LICENSE.txt")
    endforeach()
    install(FILES "${shotlet_zig_directory}/LICENSE" DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/shotlet RENAME Zig-LICENSE.txt)
    # These are stable C ABIs. libc++ is linked statically by Zig; host glibc and
    # libstdc++ are deliberately excluded from the portable package.
    string(APPEND CPACK_DEBIAN_PACKAGE_DEPENDS
        ", libc6 (>= ${SHOTLET_LINUX_GLIBC}), libx11-6, libxrandr2, libxinerama1, libfontconfig1")
else()
    # Native compiler builds must advertise the actual runtime symbol requirements.
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
endif()
set(CPACK_PACKAGE_FILE_NAME "shotlet-${PROJECT_VERSION}-linux-${CPACK_DEBIAN_PACKAGE_ARCHITECTURE}")
set(CPACK_GENERATOR "DEB;TGZ")
set(CPACK_PACKAGE_CHECKSUM SHA256)
include(CPack)
