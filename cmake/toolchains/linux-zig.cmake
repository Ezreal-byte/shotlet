# Build with bundled libc++ and an explicit glibc baseline. Dependencies are C ABI
# libraries supplied by the target desktop, not copies of the build host's libc.
set(SHOTLET_LINUX_ARCH "x86_64" CACHE STRING "Linux target: x86_64 or aarch64")
set(SHOTLET_LINUX_GLIBC "2.28" CACHE STRING "Oldest supported glibc")
set(SHOTLET_LINUX_SYSROOT "" CACHE PATH "Optional target dependency root for cross compilation")
find_program(SHOTLET_ZIG zig REQUIRED)
if(NOT SHOTLET_LINUX_ARCH MATCHES "^(x86_64|aarch64)$")
    message(FATAL_ERROR "SHOTLET_LINUX_ARCH must be x86_64 or aarch64")
endif()
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR "${SHOTLET_LINUX_ARCH}")
set(CMAKE_C_COMPILER "${SHOTLET_ZIG}")
set(CMAKE_C_COMPILER_ARG1 cc)
set(CMAKE_CXX_COMPILER "${SHOTLET_ZIG}")
set(CMAKE_CXX_COMPILER_ARG1 c++)
if(SHOTLET_LINUX_SYSROOT)
    set(shotlet_dependency_include "${SHOTLET_LINUX_SYSROOT}/usr/include")
else()
    set(shotlet_dependency_include "/usr/include")
endif()
# Native X11/Fontconfig headers must follow Zig's libc headers, otherwise the
# build host's newer glibc feature macros would silently raise the ABI baseline.
set(CMAKE_C_FLAGS_INIT "-target ${SHOTLET_LINUX_ARCH}-linux-gnu.${SHOTLET_LINUX_GLIBC} -idirafter ${shotlet_dependency_include}")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-Wl,--allow-shlib-undefined")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-Wl,--allow-shlib-undefined")
set(CMAKE_LIBRARY_ARCHITECTURE "${SHOTLET_LINUX_ARCH}-linux-gnu")
if(SHOTLET_LINUX_SYSROOT)
    set(CMAKE_FIND_ROOT_PATH "${SHOTLET_LINUX_SYSROOT}")
    set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
    set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
    set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
    set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
    set(ENV{PKG_CONFIG_SYSROOT_DIR} "${SHOTLET_LINUX_SYSROOT}")
    set(ENV{PKG_CONFIG_LIBDIR} "${SHOTLET_LINUX_SYSROOT}/usr/lib/${CMAKE_LIBRARY_ARCHITECTURE}/pkgconfig:${SHOTLET_LINUX_SYSROOT}/usr/share/pkgconfig")
endif()
# Keep explicit settings during CMake's compiler feature probes.
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
    SHOTLET_ZIG SHOTLET_LINUX_ARCH SHOTLET_LINUX_GLIBC SHOTLET_LINUX_SYSROOT)
